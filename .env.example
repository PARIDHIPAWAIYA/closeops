# Copy to .env (gitignored). All optional; the close runs without any of them.
ANTHROPIC_API_KEY=            # enables `closeops decide` (Claude judgment step)
NEATLOGS_API_KEY=             # traces every model judgment at app.neatlogs.com
DODO_PAYMENTS_API_KEY=        # test-mode key; enables `scripts/fetch_dodo.py --live`
CLOSEOPS_MAX_USD=5            # hard cap on model spend per `decide` run
